# Required. Supply this on the VPS, never in GitHub Actions or the build.
NAPSTR_NSEC=nsec1_replace_with_your_private_key
# Match the systemd ReadWritePaths setting when changing this path.
NAPSTR_MUSIC_DIR=/srv/napstr/music

# Optional. The supplied systemd unit makes /var/lib/napstrd writable.
NAPSTR_DATA_DIR=/var/lib/napstrd
NAPSTR_SCAN_INTERVAL=60
# NAPSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# NAPSTR_TOR_PATH=/usr/bin/tor
