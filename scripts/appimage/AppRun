#!/usr/bin/env bash
set -e

appdir="$(readlink -f "$(dirname "$0")")"
export APPDIR="$appdir"
export PATH="$appdir/usr/bin:${PATH:-/usr/bin:/bin}"
export XDG_DATA_DIRS="$appdir/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Rodio uses ALSA on Linux. Keep its configuration and Pulse bridge inside the
# AppImage so the packaged build reaches PulseAudio or PipeWire's Pulse server
# instead of probing a physical sound device. On systems without that shared
# server, retain ALSA's normal configured default.
export ALSA_CONFIG_DIR="$appdir/usr/share/alsa"
export ALSA_PLUGIN_DIR="$appdir/usr/lib/alsa-lib"
pulse_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native"
if [[ -n "${PULSE_SERVER:-}" || -S "$pulse_socket" ]]; then
  export ALSA_CONFIG_PATH="$appdir/usr/share/alsa/napstr-pulse.conf"
else
  export ALSA_CONFIG_PATH="$appdir/usr/share/alsa/alsa.conf"
fi

# Keep the GTK and GStreamer integration prepared by linuxdeploy. The hooks
# are generated inside the AppImage.
# shellcheck disable=SC1091
source "$appdir/apprun-hooks/linuxdeploy-plugin-gtk.sh"
export LD_LIBRARY_PATH="$appdir/usr/lib:$appdir/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# shellcheck disable=SC1091
source "$appdir/apprun-hooks/linuxdeploy-plugin-gstreamer.sh"

# WebKitGTK's helper paths in this AppDir are relative to usr/.
cd "$appdir/usr"
exec "$appdir/usr/bin/napstr" "$@"
